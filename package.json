{
  "name": "job-hunt-companion",
  "version": "0.1.0",
  "description": "Track job applications as notes: paste a posting, get a structured note and a board; a local model tailors your resume bullets and drafts interview questions.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && eslint . && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "posting:live": "esbuild scripts/posting-live.ts --bundle --platform=node --format=cjs --outfile=.e2e/posting-live.cjs --log-level=warning && node .e2e/posting-live.cjs"
  },
  "keywords": [
    "obsidian",
    "jobs",
    "applications",
    "resume",
    "interview",
    "ollama"
  ],
  "author": "Tony Peonio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
